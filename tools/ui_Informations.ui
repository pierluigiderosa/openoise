          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="textInteractionFlags">
           <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="labelFolder">
          <property name="font">
           <font>
            <pointsize>11</pointsize>
           </font>
          </property>
          <property name="text">
           <string>TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabeTextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabel TextLabe</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="margin">
           <number>15</number>
          </property>
          <property name="textInteractionFlags">
           <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_8">
          <property name="font">
           <font>
            <pointsize>11</pointsize>
           </font>
          </property>
          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;br/&gt;The dataset contains 9 LAYER shapefiles that can help the user to understand how to compile the attribute tables of the layers in order to run the computation of the noise with the different sources.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;LAYERS:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;3. sources_points&lt;br/&gt;4. roads_NMPB_emission&lt;br/&gt;5. roads_NMPB_traffic_flow&lt;br/&gt;6. roads_CNOSSOS_traffic_flow&lt;br/&gt;7. grid_receivers (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;8. contours_levels (layer created with the tool 'Contours Levels')&lt;br/&gt;9. polygon_levels (layer created with the tool 'Contours Levels')&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
          </property>
          <property name="wordWrap">
