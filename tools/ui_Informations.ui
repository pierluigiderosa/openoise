     <widget class="QWidget" name="tab">
      <attribute name="title">
       <string>opeNoise</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout">
       <item>
        <widget class="QLabel" name="label">
         <property name="font">
          <font>
           <pointsize>11</pointsize>
          </font>
         </property>
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;OpeNoise&lt;/span&gt;&lt;/p&gt;&lt;p&gt;The plugin allows to estimate noise levels generated by point sources or by road sources at fixed receiver points and buildings. NMPB-Routes-96 and CNOSSOS methods for road emission are implemented.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;Please consider the following condition&lt;/p&gt;&lt;p&gt;1) are taken into account:&lt;/p&gt;&lt;p&gt;- geometrical divergence&lt;br/&gt;- atmospheric absorption&lt;br/&gt;- pure diffraction, with no ground effects, for horizontal and vertical obstacles &lt;br/&gt;- modelization is 3D&lt;br/&gt;&lt;/p&gt;&lt;p&gt;2) are not taken into account:&lt;/p&gt;&lt;p&gt;- reflection&lt;br/&gt;- terrain is flat&lt;br/&gt;- ground effect&lt;br/&gt;- meteorological conditions&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Reference Documentation:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32015L0996&amp;amp;from=PT&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;COMMISSION DIRECTIVE (EU) 2015/996&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;- &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32021L1226&amp;amp;from=IT&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;COMMISSION DIRECTIVE (EU) 2021/1226&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;- &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020L0367&amp;amp;from=IT&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;COMMISSION DIRECTIVE (EU) 2020/367&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="textFormat">
          <enum>Qt::AutoText</enum>
         </property>
         <property name="alignment">
          <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="openExternalLinks">
          <bool>true</bool>
         </property>
         <property name="textInteractionFlags">
          <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_2">
      <attribute name="title">
       <string>How it works</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="QToolBox" name="toolBox">
         <property name="currentIndex">
          <number>4</number>
         </property>
         <widget class="QWidget" name="page">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>683</width>
            <height>710</height>
           </rect>
          </property>
          <attribute name="label">
           <string>1  -   CREATE RECEIVER OR GRID POINTS</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_5">
           <property name="sizeConstraint">
            <enum>QLayout::SetDefaultConstraint</enum>
           </property>
           <item>
            <widget class="QLabel" name="label_2">
             <property name="font">
              <font>
               <pointsize>11</pointsize>
              </font>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;CRETAE RECEIVERS&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;In according to case 2b - § 2.8 Directive 2002/49/EC Annex II&lt;br/&gt;&lt;/span&gt;&lt;br/&gt;The tool generates receiver point. Façade are split up every 5 m from the start position onward, with a receiver position placed at the halfway the 5 m segment. The remaining section has its receiver point in its mid-point. The receivers are located at 4m above the ground, default. &lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m.&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;GRID POINTS&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;In according to § 2.8 Directive 2002/49/EC Annex II&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;&lt;br/&gt;&lt;/span&gt;The tool generates a series of receivers point with a certain spacing, located at 4m above the ground, default. &lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m. Subsequently, the sound levels can be calculated with the tool CALCULATE NOISE LEVELS and subsequently with the tool COUNTER LEVELS draw the level curves.&lt;br/&gt;&lt;/p&gt;&lt;p&gt;INPUT DATA:&lt;/p&gt;&lt;p&gt;- Buildings (Polygons layer)&lt;/p&gt;&lt;p&gt;OUTPUT DATA:&lt;/p&gt;&lt;p&gt;- Receiver points (Points layer)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in Data Set for Testing&lt;/span&gt;&lt;/p&gt;&lt;p&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;7. grid_receivers (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="textInteractionFlags">
              <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_2">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>704</width>
            <height>472</height>
           </rect>
          </property>
          <attribute name="label">
           <string>2  -   CALCULATE NOISE LEVELS</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_4">
           <item>
            <widget class="QToolBox" name="toolBox_2">
             <property name="currentIndex">
              <number>1</number>
             </property>
             <widget class="QWidget" name="page_5">
              <property name="geometry">
               <rect>
                <x>0</x>
                <y>0</y>
                <width>148</width>
                <height>3562</height>
               </rect>
              </property>
              <attribute name="label">
               <string>2A - Point Sources Calculation</string>
              </attribute>
              <layout class="QVBoxLayout" name="verticalLayout_6">
               <item>
                <widget class="QLabel" name="label_3">
                 <property name="font">
                  <font>
                   <pointsize>11</pointsize>
                  </font>
                 </property>
                 <property name="text">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;This tool estimates noise levels at receiver points (a point layer) from point sources (a point layer)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;A ray is traced between each point source and each receiver point and then, if the length of the ray is lower then a fixed distance (chosen in the Parameters form), noise level will be calculated.&lt;/p&gt;&lt;p&gt;In the calculation it's taken into account the geometrical divergence for a spherical point source, atmospheric absorption and pure diffraction, with no ground effects, for horizontal and vertical obstacles. &lt;/p&gt;&lt;p&gt;The receiving points are located 4m above ground level, default. &lt;br/&gt;&lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m.&lt;/p&gt;&lt;p&gt;If the ray crosses an obstacle, it won't be considered. &lt;/p&gt;&lt;p&gt;It's possible to create the rays layer.&lt;/p&gt;&lt;p&gt;In the calculation the buldings are considerable as obstacles. To take into account the building in 3D you can create a new attribute with a height field of buildings.&lt;br/&gt;For this reason it is possible to insert noise barrier in this layer.&lt;/p&gt;&lt;p&gt;The computation is available for 4 reference periods: &lt;br/&gt;Generic, Day, Evening, Nigth. In addition, it is possible to calculate Lden using the indication of the European Directive 2002/49/EC (defining the lasting time for each reference period).&lt;/p&gt;&lt;p&gt;The results are written in the attribute table of the receiver points layer and are expressed in dB(A). &lt;br/&gt;If the level is not calculated or it is less than zero the value -99 is assigned.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;INPUT DATA:&lt;/p&gt;&lt;p&gt;- Receiver points (Point layer)&lt;/p&gt;&lt;p&gt;- Point sources (Point layer with a field containing the power level of the sources)&lt;/p&gt;&lt;p&gt;- Buildings (Polygon layer) - optional –&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;OUTPUT DATA:&lt;/p&gt;&lt;p&gt;- Direct sound rays (Polyline layer) - optional -&lt;/p&gt;&lt;p&gt;- Diffracted sound rays (Polyline layer) - optional -&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in Data Set for Testing&lt;/span&gt;&lt;/p&gt;&lt;p&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;3. sources_points&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                 <property name="textInteractionFlags">
                  <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
             <widget class="QWidget" name="page_6">
              <property name="geometry">
               <rect>
                <x>0</x>
                <y>0</y>
                <width>661</width>
                <height>1360</height>
               </rect>
              </property>
              <attribute name="label">
               <string>2B - Road Sources Calculation</string>
              </attribute>
              <layout class="QVBoxLayout" name="verticalLayout_7">
               <item>
                <widget class="QLabel" name="label_4">
                 <property name="font">
                  <font>
                   <pointsize>11</pointsize>
                   <weight>50</weight>
                   <italic>false</italic>
                   <bold>false</bold>
                  </font>
                 </property>
                 <property name="text">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;The tool estimates noise level at receiver points (a point layer) generated by road sources (a linear layer)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;For each road (line of the polyline layer) the sound power level is calculated in accordance with NMPB '96 or CNOSSOS standards. &lt;/p&gt;&lt;p&gt;Then each road is divided in emission points spaced half of the minimum distance receiver points - road. &lt;/p&gt;&lt;p&gt;A ray is traced between each emission point and each receiver point and then, if the length of the ray is lower then a fixed distance (chosen in the Parameters form), noise level will be calculated (the distance is calculated considering the receiver points at 4m above the ground, default. &lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m.&lt;br/&gt;&lt;/p&gt;&lt;p&gt;In the calculation it's taken into account the geometrical divergence, atmospheric absorption and pure diffraction, with no ground effects, for horizontal and vertical obstacles.&lt;/p&gt;&lt;p&gt;If the ray crosses an obstacle, it won't be considered.&lt;/p&gt;&lt;p&gt;It's possible to create the emission points and rays layers. &lt;/p&gt;&lt;p&gt;In the calculation the buldings are considerable as obstacles. To take into account the building in 3D you can create a new attribute with a height field of buildings.&lt;br/&gt;For this reason it is possible to insert noise barrier in this layer.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;The computation is available for 4 reference periods: Generic, Day, Evening, Nigth. &lt;br/&gt;In addition, it is possible to calculate Lden using the indication of the European Directive 2002/49/EC (defining the lasting time for each reference period). &lt;/p&gt;&lt;p&gt;&lt;br/&gt;The results are written in the attribute table of the receiver points layer and are expressed in dB(A). &lt;br/&gt;If the level is not calculated or is less than zero the value -99 is assigned.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;INPUT DATA: &lt;/p&gt;&lt;p&gt;- Receiver points (Point layer)&lt;/p&gt;&lt;p&gt;- Roads (Polyline layer) - In the attributes table it's necessary to have some fields with information about the characteristic of the single road to estimates the sound power level in accordance with NMPB '96 and CNOSSOS (Example can be viewed in the Data Set for testing).&lt;/p&gt;&lt;p&gt;- Buildings (Polygon layer) - optional -&lt;/p&gt;&lt;p&gt;&lt;br/&gt;OUTPUT DATA:&lt;/p&gt;&lt;p&gt;- Direct sound rays (Polyline layer) - optional -&lt;/p&gt;&lt;p&gt;- Diffracted sound rays (Polyline layer) - optional -&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in Data Set for Testing&lt;/span&gt;&lt;/p&gt;&lt;p&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;4. roads_NMPB_emission&lt;br/&gt;5. roads_NMPB_traffic_flow&lt;br/&gt;6. roads_CNOSSOS_traffic_flow&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                 <property name="textInteractionFlags">
                  <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_3">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>148</width>
            <height>1552</height>
           </rect>
          </property>
          <attribute name="label">
           <string>3  -   NOISE EXPOSURE</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_8">
           <item>
            <widget class="QLabel" name="label_5">
             <property name="font">
              <font>
               <pointsize>11</pointsize>
              </font>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;The tool assigns dwellings and people living in dwellings to receiver points in according to § 2.8 Directive 2002/49/EC Annex II&lt;/span&gt;&lt;/p&gt;&lt;p&gt;It is necessary to enter the information of how many people and how many dwellings are present for each building and what type of exposure the fa&lt;a name=&quot;docs-internal-guid-48a0e909-7fff-84c6-6090-918592b4b1c4&quot;/&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;ç&lt;/span&gt;ade has in according to §2.8 Directive 2002/49/EC Annex II. &lt;br/&gt;&lt;/p&gt;&lt;p&gt;NOTE: this tool works correctly only if the receiver points layer is created from a buildings layer with opeNoise and the attributes table is not modified.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;INPUT DATA:&lt;/p&gt;&lt;p&gt;- Receiver points (Point layer) - In the attributes table it's necessary to have at least a field with noise levels&lt;/p&gt;&lt;p&gt;- Buildings (Polygon layer)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in Data Set for Testing&lt;/span&gt;&lt;/p&gt;&lt;p&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="textInteractionFlags">
              <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_4">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>704</width>
            <height>472</height>
           </rect>
          </property>
          <attribute name="label">
           <string>4  -   APPLY NOISE SIMBOLOGY</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_9">
           <item>
            <widget class="QLabel" name="label_6">
             <property name="font">
              <font>
               <pointsize>11</pointsize>
              </font>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;The tool assigns a noise level symbology to a layer with a sound level field in the attribute table&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;INPUT DATA:&lt;/p&gt;&lt;p&gt;- Point, polilyne or polygon layer - In the attributes table it's necessary to have at least a field with noise levels&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="textInteractionFlags">
              <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_7">
          <attribute name="label">
           <string>5  -   CONTOURS LEVEL</string>
          </attribute>
