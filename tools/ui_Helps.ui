     <widget class="QWidget" name="tab">
      <attribute name="title">
       <string>opeNoise</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout">
       <item>
        <widget class="QLabel" name="label">
         <property name="font">
          <font>
           <pointsize>11</pointsize>
          </font>
         </property>
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;OpeNoise&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;The plugin allows to estimate noise levels generated by point sources or by road sources at fixed receiver points and buildings. NMPB-Routes-96 and CNOSSOS methods for road emission are implemented.&lt;br/&gt;&lt;br/&gt;WARNING: The plugin supports only projected CRS files&lt;/p&gt;&lt;p&gt;&lt;br/&gt;Please consider the following condition&lt;/p&gt;&lt;p&gt;1) are taken into account:&lt;/p&gt;&lt;p&gt;- geometrical divergence&lt;br/&gt;- atmospheric absorption&lt;br/&gt;- pure diffraction, with no ground effects, for horizontal and vertical obstacles &lt;br/&gt;- modelization is 3D&lt;br/&gt;&lt;/p&gt;&lt;p&gt;2) are not taken into account:&lt;/p&gt;&lt;p&gt;- reflection&lt;br/&gt;- terrain is flat&lt;br/&gt;- ground effect&lt;br/&gt;- meteorological conditions&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Reference Documentation:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32002L0049&amp;amp;from=EN&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;Directive 2002/49/EC&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;- Annex II to Directive 2002/49/EC &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32015L0996&amp;amp;from=PT&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;COMMISSION DIRECTIVE (EU) 2015/996&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;- amends Annex II to Directive 2002/49/EC &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32021L1226&amp;amp;from=IT&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;COMMISSION DIRECTIVE (EU) 2021/1226&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;- amends Annex III to Directive 2002/49/EC &lt;a href=&quot;https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020L0367&amp;amp;from=IT&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;COMMISSION DIRECTIVE (EU) 2020/367&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="textFormat">
          <enum>Qt::AutoText</enum>
         </property>
         <property name="alignment">
          <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="openExternalLinks">
          <bool>true</bool>
         </property>
         <property name="textInteractionFlags">
          <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_How_it_Work">
      <attribute name="title">
       <string>How it Works</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="QToolBox" name="toolBox">
         <property name="currentIndex">
          <number>0</number>
         </property>
         <widget class="QWidget" name="page">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>712</width>
            <height>621</height>
           </rect>
          </property>
          <attribute name="label">
           <string>1  -   CREATE RECEIVER OR GRID</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_5">
           <property name="sizeConstraint">
            <enum>QLayout::SetDefaultConstraint</enum>
           </property>
           <item>
            <widget class="QLabel" name="label_2">
             <property name="font">
              <font>
               <pointsize>11</pointsize>
              </font>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;CRETAE RECEIVERS&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;In according to case 2b - § 2.8 Directive 2002/49/EC Annex II&lt;br/&gt;&lt;/span&gt;&lt;br/&gt;The tool generates receiver point. Façade are split up every 5 m from the start position onward, with a receiver position placed at the halfway the 5 m segment. The remaining section has its receiver point in its mid-point. The receivers are located at 4m above the ground, default. &lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m.&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;GRID POINTS&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;In according to § 2.8 Directive 2002/49/EC Annex II&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;&lt;br/&gt;&lt;/span&gt;The tool generates a series of receivers point with a certain spacing, located at 4m above the ground, default. &lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m. Subsequently, the sound levels can be calculated with the tool CALCULATE NOISE LEVELS and subsequently with the tool CONTOURS LEVEL draw the level curves.&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;INPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- Buildings (Polygons layer)&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;OUTPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- Receiver points (Points layer)&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in - Data Set for Testing -&lt;/span&gt;&lt;/p&gt;&lt;p&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;7. grid_receivers (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="textInteractionFlags">
              <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_2">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>98</width>
            <height>141</height>
           </rect>
          </property>
          <attribute name="label">
           <string>2  -   CALCULATE NOISE LEVELS</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_4">
           <item>
            <widget class="QToolBox" name="toolBox_2">
             <property name="currentIndex">
              <number>1</number>
             </property>
             <widget class="QWidget" name="page_5">
              <property name="geometry">
               <rect>
                <x>0</x>
                <y>0</y>
                <width>122</width>
                <height>2928</height>
               </rect>
              </property>
              <attribute name="label">
               <string>2A - Point Sources Calculation</string>
              </attribute>
              <layout class="QVBoxLayout" name="verticalLayout_6">
               <item>
                <widget class="QLabel" name="label_3">
                 <property name="font">
                  <font>
                   <pointsize>11</pointsize>
                  </font>
                 </property>
                 <property name="text">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;This tool estimates noise levels at receiver points (a point layer) from point sources (a point layer)&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;A ray is traced between each point source and each receiver point and then, if the length of the ray is lower then a fixed distance (chosen in the Parameters form), noise level will be calculated.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;In the calculation it's taken into account the geometrical divergence for a spherical point source, atmospheric absorption and pure diffraction, with no ground effects, for horizontal and vertical obstacles. &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;The receiving points are located 4m above ground level, default. &lt;br/&gt;&lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;If the ray crosses an obstacle, it won't be considered. &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;It's possible to create the rays layer.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;In the calculation the buldings are considerable as obstacles. To take into account the building in 3D you can create a new attribute with a height field of buildings.&lt;br/&gt;For this reason it is possible to insert noise barrier in this layer.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;The computation is available for 4 reference periods: &lt;br/&gt;Generic, Day, Evening, Nigth. In addition, it is possible to calculate Lden using the indication of the European Directive 2002/49/EC (defining the lasting time for each reference period).&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;The results are written in the attribute table of the receiver points layer and are expressed in dB(A). &lt;br/&gt;If the level is not calculated or it is less than zero the value -99 is assigned.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;INPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Receiver points (Point layer)&lt;br/&gt;- Point sources (Point layer with a field containing the power level of the sources)&lt;br/&gt;- Buildings (Polygon layer) - optional –&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;OUTPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Direct sound rays (Polyline layer) - optional -&lt;br/&gt;- Diffracted sound rays (Polyline layer) - optional -&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in - Data Set for Testing -&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;3. sources_points&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                 <property name="textInteractionFlags">
                  <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
             <widget class="QWidget" name="page_6">
              <property name="geometry">
               <rect>
                <x>0</x>
                <y>0</y>
                <width>205</width>
                <height>2166</height>
               </rect>
              </property>
              <attribute name="label">
               <string>2B - Road Sources Calculation</string>
              </attribute>
              <layout class="QVBoxLayout" name="verticalLayout_7">
               <item>
                <widget class="QLabel" name="label_4">
                 <property name="font">
                  <font>
                   <pointsize>11</pointsize>
                   <weight>50</weight>
                   <italic>false</italic>
                   <bold>false</bold>
                  </font>
                 </property>
                 <property name="text">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;The tool estimates noise level at receiver points (a point layer) generated by road sources (a linear layer)&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;For each road (line of the polyline layer) the sound power level is calculated in accordance with NMPB '96 or CNOSSOS standards. &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Then each road is divided in emission points spaced half of the minimum distance receiver points - road. &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;A ray is traced between each emission point and each receiver point and then, if the length of the ray is lower then a fixed distance (chosen in the Parameters form), noise level will be calculated (the distance is calculated considering the receiver points at 4m above the ground, default. &lt;a name=&quot;tw-target-text&quot;/&gt;Otherwise you can create a new attribute with a height field other than 4m.&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;In the calculation it's taken into account the geometrical divergence, atmospheric absorption and pure diffraction, with no ground effects, for horizontal and vertical obstacles.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;If the ray crosses an obstacle, it won't be considered.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;It's possible to create the emission points and rays layers. &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;In the calculation the buldings are considerable as obstacles. To take into account the building in 3D you can create a new attribute with a height field of buildings.&lt;br/&gt;For this reason it is possible to insert noise barrier in this layer.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;The computation is available for 4 reference periods: Generic, Day, Evening, Nigth. &lt;br/&gt;In addition, it is possible to calculate Lden using the indication of the European Directive 2002/49/EC (defining the lasting time for each reference period). &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;The results are written in the attribute table of the receiver points layer and are expressed in dB(A). &lt;br/&gt;If the level is not calculated or is less than zero the value -99 is assigned.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;INPUT DATA: &lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Receiver points (Point layer)&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Roads (Polyline layer) - In the attributes table it's necessary to have some fields with information about the characteristic of the single road to estimates the sound power level in accordance with NMPB '96 and CNOSSOS (Example can be viewed in the Data Set for testing).&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Buildings (Polygon layer) - optional -&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;OUTPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Direct sound rays (Polyline layer) - optional -&lt;br/&gt;- Diffracted sound rays (Polyline layer) - optional -&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in - Data Set for Testing -&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;4. roads_NMPB_emission&lt;br/&gt;5. roads_NMPB_traffic_flow&lt;br/&gt;6. roads_CNOSSOS_traffic_flow&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                 <property name="textInteractionFlags">
                  <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="page_3_1">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>98</width>
            <height>28</height>
           </rect>
          </property>
          <attribute name="label">
           <string>3  -   CONTOURS LEVEL</string>
          </attribute>
          <widget class="QLabel" name="label_9">
           <property name="geometry">
            <rect>
             <x>10</x>
             <y>0</y>
             <width>682</width>
             <height>450</height>
            </rect>
           </property>
           <property name="font">
            <font>
             <pointsize>11</pointsize>
            </font>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;The tool draws a layer of contours starting from the previously calculated grid receivers &lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;NOTE: Run this tool after create a grid receivers and calculation noise levels for it.&lt;br/&gt;&lt;br/&gt;- choose the receptor grid previously created with the tool CREATE RECEIVERS OR GRID;&lt;br/&gt;- choose the noise levels you want to draw the contour lines;&lt;br/&gt;- &lt;a name=&quot;tw-target-text&quot;/&gt;choose the minimum and maximum noise levels you want to draw;&lt;br/&gt;- choose the range of contour lines;&lt;br/&gt;- save countour line and contours (polygon layer);&lt;br/&gt;- the total area in m&lt;span style=&quot; vertical-align:super;&quot;&gt;2&lt;/span&gt; exposed to values interval is stored in the polygon levels. &lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;INPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Point layer - In the attributes table it's necessary to have at least a field with noise levels&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;OUTPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;- &lt;/span&gt;polilyne layer - contours levels&lt;br/&gt;- polygon layer - polygon levels - the total area in m&lt;span style=&quot; font-style:italic; vertical-align:super;&quot;&gt;2&lt;/span&gt; exposed to values interval is stored &lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in - Data Set for Testing -&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;7. grid_receivers (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;8. contours_levels (layer created with the tool 'Contours Levels')&lt;br/&gt;9. polygon_levels (layer created with the tool 'Contours Levels')&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
           <property name="textInteractionFlags">
            <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
           </property>
          </widget>
         </widget>
         <widget class="QWidget" name="page_4_1">
          <property name="geometry">
           <rect>
            <x>0</x>
            <y>0</y>
            <width>126</width>
            <height>3885</height>
           </rect>
          </property>
          <attribute name="label">
           <string>4  -   NOISE EXPOSURE</string>
          </attribute>
          <layout class="QVBoxLayout" name="verticalLayout_8">
           <item>
            <widget class="QLabel" name="label_5">
             <property name="font">
              <font>
               <pointsize>11</pointsize>
              </font>
             </property>
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;The tool assigns dwellings and people living in dwellings to receiver points and evaluetes the harmful effects of ambient noise &lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;in according to § 2.8 Directive 2002/49/EC Annex II and ANNEX III&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;It is necessary to enter the information of how many people and how many dwellings are present for each building and what type of exposure the fa&lt;a name=&quot;docs-internal-guid-48a0e909-7fff-84c6-6090-918592b4b1c4&quot;/&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;ç&lt;/span&gt;ade has in according to §2.8 Directive 2002/49/EC Annex II.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;People: &lt;/span&gt;the estimated number of people living in each building&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Dwellings: &lt;/span&gt;the estimated number of dwellings for each building &lt;span style=&quot; font-weight:600; font-style:italic; text-decoration: underline;&quot;&gt;&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;&lt;br/&gt;Façade type Exposition &lt;/span&gt;type of exposition for each building (type string)&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic; text-decoration: underline;&quot;&gt;Consider the following codificas:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&amp;quot;&lt;span style=&quot; font-weight:600;&quot;&gt;1&lt;/span&gt;&amp;quot; &lt;span style=&quot; font-style:italic;&quot;&gt;Single dwellings -&lt;/span&gt; Where information on the location of dwellings within building footprints is available, that dwelling and the people living in that dwelling are assigned to the receiver point at the most exposed façade of that dwelling. For example, for detached houses, for semi-detached and terrace houses, or apartment buildings, where the internal division of the building is known, or for buildings with a floor size that indicates a single dwelling per floor level, or for buildings with a floor size and height that indicates a single dwelling per building.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&amp;quot;&lt;span style=&quot; font-weight:600;&quot;&gt;2&lt;/span&gt;&amp;quot; &lt;span style=&quot; font-style:italic;&quot;&gt;appartments single façade type exposition&lt;/span&gt; - Available information shows that dwellings are arranged within an apartment building such that they have a single façade exposed to noise&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&amp;quot;&lt;span style=&quot; font-weight:600;&quot;&gt;3&lt;/span&gt;&amp;quot; &lt;span style=&quot; font-style:italic;&quot;&gt;appartment multi façade type exposition&lt;/span&gt; - Available information shows that dwellings are arranged within an apartment building such that they have more than one façade exposed to noise, or no information is available on how many facades of the dwellings are exposed to noise.&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;The tool evaluates the &lt;span style=&quot; font-weight:600;&quot;&gt;harmful effects of environmental noise&lt;/span&gt; in terms of number N of people affected by the harmful effect: High Annoyance (N&lt;span style=&quot; vertical-align:sub;&quot;&gt;HA,road&lt;/span&gt;) and High Sleep Disturbance (N&lt;span style=&quot; vertical-align:sub;&quot;&gt;HSD,road&lt;/span&gt;) and in percentage term of the total population (%N&lt;span style=&quot; vertical-align:sub;&quot;&gt;HA,road&lt;/span&gt; and %N&lt;span style=&quot; vertical-align:sub;&quot;&gt;HSD,road&lt;/span&gt;), for road noise in according to Directive 2002/49/EC Annex III.&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;WARNING&lt;/span&gt;: this tool works correctly only if the receiver points layer is created from a buildings layer with opeNoise and the attributes table is not modified.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;INPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Receiver points (Point layer) - In the attributes table it's necessary to have at least a field with noise levels&lt;br/&gt;- Buildings (Polygon layer)&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;OUTPUT DATA:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;- Noise Exposure - Lden (table)&lt;br/&gt;- Noise Exposure - Lnight (table)&lt;br/&gt;- &lt;a name=&quot;docs-internal-guid-b26c9a40-7fff-c3a2-985f-07f64eb589fc&quot;/&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;H&lt;/span&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;igh Annoyance - Lden &lt;/span&gt;(table)&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;&lt;br/&gt;- &lt;/span&gt;&lt;a name=&quot;docs-internal-guid-85a38a4a-7fff-3e93-da4a-364cd00a92f6&quot;/&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;H&lt;/span&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-size:12.5pt; color:#000000; background-color:transparent;&quot;&gt;igh Sleep Disturbance - Lnight &lt;/span&gt;(table)&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;Reference Layer in - Data Set for Testing -&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;1. buildings&lt;br/&gt;2. receveirs_points (layer created with the tool 'Create Receiver or Grid Points')&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="textInteractionFlags">
              <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
